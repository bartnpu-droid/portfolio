# --- AI model ---
# anthropic | openai | mock (offline demo without a key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave empty for the default (claude-haiku-5-5 / gpt-4o-mini)
LLM_MODEL=
MAX_OUTPUT_TOKENS=1024
# Claude's extended thinking: off = faster, cheaper replies (recommended for a receptionist)
ANTHROPIC_THINKING=off
# USD per 1M tokens, for the budget cap and /admin (defaults = Claude Haiku 5.5 list prices)
PRICE_INPUT_PER_M=0.10
PRICE_OUTPUT_PER_M=0.50
# Spam protection: hard daily AI budget, messages per patient per day, website messages per IP per day
DAILY_BUDGET_USD=3
DAILY_MESSAGE_LIMIT=40
IP_DAILY_LIMIT=100

# --- Telegram (optional: without a token only the website chat runs) ---
BOT_TOKEN=
ADMIN_IDS=

# --- Website ---
WEB_PORT=8090
PUBLIC_URL=
# 1 = ask search engines not to index the site (demo clinic); 0 for a real clinic
SITE_NOINDEX=1
# Booking form: requests per IP address per hour
FORM_HOURLY_LIMIT=5

# --- Clinic ---
CLINIC_NAME=BrightSmile Dental
CLINIC_PHONE=020 0000 0000
TIMEZONE=Europe/London
