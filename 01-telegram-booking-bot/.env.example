# --- Telegram ---
BOT_TOKEN=paste-your-token-from-BotFather
# Telegram IDs of staff who get the /admin panel (comma separated). Get yours from @userinfobot
ADMIN_IDS=123456789
# Public HTTPS address of this server (needed for the Mini App). See README → "Mini App URL"
WEBAPP_URL=https://your-domain.example

# --- Web server ---
WEB_HOST=0.0.0.0
WEB_PORT=8080

# --- Shop ---
SHOP_NAME=Northside Barber Co.
SHOP_ADDRESS=24 Baker Street, London
SHOP_PHONE=+44 20 0000 0000
SHOP_LAT=51.5203
SHOP_LON=-0.1571
TIMEZONE=Europe/London
CURRENCY=$
OPEN_TIME=10:00
CLOSE_TIME=20:00
SLOT_STEP_MIN=15
MIN_LEAD_MIN=30
BOOKING_DAYS_AHEAD=14

# --- Languages (first one is the default) ---
LANGUAGES=en
DEFAULT_LANG=en

# --- Optional: Google Sheets export ---
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS=

# Preview the Mini App in a normal browser: http://localhost:8080/?dev_user=1  (never enable in production)
DEV_MODE=0

# --- Optional: online payments (Telegram Payments) ---
# Token from @BotFather → your bot → Payments. A TEST token takes test cards only.
PAYMENT_TOKEN=
PAYMENT_CURRENCY=USD
PAYMENT_HOLD_MIN=15
REFUND_FREE_HOURS=24
